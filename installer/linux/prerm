#!/bin/sh
set -e
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -f "$XDG_RUNTIME_DIR/printcostprofit-$(id -u).pid" ]; then
  pid=$(cat "$XDG_RUNTIME_DIR/printcostprofit-$(id -u).pid" 2>/dev/null || true)
  [ -z "$pid" ] || kill "$pid" 2>/dev/null || true
  rm -f "$XDG_RUNTIME_DIR/printcostprofit-$(id -u).pid"
fi
exit 0
